    "synthetic": {
      "type": "boolean",
      "description": "Истина для синтетических данных; должна соответствовать source всех свидетельств."
    },
    "target_alias": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "maxLength": 64,
