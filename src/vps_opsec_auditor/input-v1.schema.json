        "max_age_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8760,
          "description": "Максимальный возраст свидетельства в часах."
        },
        "min_tls_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365,
          "description": "Минимальный остаток срока TLS в днях."
        },
        "min_retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 36500,
          "description": "Минимальный срок хранения резервных копий в днях."
        },
        "max_rpo_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5256000,
          "description": "Максимальный допустимый RPO в минутах."
        },
        "max_rto_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5256000,
          "description": "Максимальный допустимый RTO в минутах."
        }
      },
      "required": [
        "max_age_hours",
        "min_tls_days",
        "min_retention_days",
        "max_rpo_minutes",
        "max_rto_minutes"
      ],
      "additionalProperties": false,
      "description": "Пороги владельца для оценки; примеры не являются универсальной политикой."
